{
  "name": "crypto-trivia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 3051",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "db:local": "wrangler d1 migrations apply openkrillion --local",
    "db:remote": "wrangler d1 migrations apply openkrillion --remote --config wrangler.production.jsonc",
    "db:migrate": "node scripts/migrate.mjs",
    "test:browser": "node scripts/browser-audit.mjs",
    "test:mobile": "node scripts/mobile-flow-audit.mjs"
  },
  "devDependencies": {
    "@fontsource/vt323": "^5.2.7",
    "playwright": "^1.58.0",
    "sharp": "^0.35.5",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  }
}
